{
  // Turing Smart Screen dashboard for the desktop: six cards, 3 x 2. See docs/guide.md for the full schema.
  // Widgets are drawn in order, later ones on top. After editing, pick the config again from the tray menu.
  // The weather needs a latitude and longitude under "weather" in settings.json; until then it shows "--".
  // Three values to fit to your PC: the network graphs' 30 (MB/s), the disk graphs' 200 (MB/s) and the
  // power graph's 500 (W).
  "name": "Default",
  "refreshMs": 1000,
  "orientation": "landscape",
  "background": "#000000",
  "widgets": [
    { "type": "image", "path": "background.png", "x": 0, "y": 0 },

    // ── Time and weather ────────────────────────────────────────────────────
    { "type": "panel", "x": 8, "y": 8, "w": 148, "h": 148, "radius": 10, "fill": "#B0080C14", "border": { "color": "#1E2636", "width": 1 } },
    { "type": "text", "clock": "h:mm", "x": 20, "y": 20, "size": 26, "weight": 600, "color": "#FFFFFF" },
    { "type": "text", "clock": "tt", "x": 92, "y": 28, "size": 15, "weight": 600, "color": "#C8CEDA" },
    { "type": "text", "clock": "ddd  d MMM", "upper": true, "x": 21, "y": 52, "size": 15, "weight": 600, "color": "#00C8FF" },
    { "type": "panel", "x": 20, "y": 76, "w": 124, "h": 1, "fill": "#1E2636" },
    { "type": "text", "weather": "icon", "font": "Segoe UI Symbol", "x": 18, "y": 88, "size": 30, "color": "#FFC53D" },
    { "type": "text", "sensor": "weather.temp", "format": "{0:F0}°", "x": 62, "y": 90, "size": 26, "weight": 600, "color": "#FFFFFF" },
    { "type": "text", "sensors": ["weather.high", "weather.low"], "format": "{0:F0}° / {1:F0}°", "x": 21, "y": 132, "size": 15, "weight": 600, "color": "#8A93A6" },
    { "type": "text", "sensor": "weather.precip", "format": "☂ {0:F0}%", "font": "Segoe UI Symbol", "x": 144, "y": 132, "align": "right", "size": 15, "weight": 600, "color": "#3D8BFF" },

    // ── CPU gauge ───────────────────────────────────────────────────────────
    { "type": "panel", "x": 166, "y": 8, "w": 148, "h": 148, "radius": 10, "fill": "#B0080C14", "border": { "color": "#1E2636", "width": 1 },
      "accent": { "edge": "top", "color": "#00E08A", "width": 3 } },
    { "type": "text", "value": "", "font": "Segoe Fluent Icons", "size": 15, "x": 178, "y": 21, "color": "#00E08A" },
    { "type": "text", "value": "CPU", "x": 200, "y": 22, "size": 13, "weight": 600, "color": "#8A93A6" },
    { "type": "gauge", "sensor": "cpu.load", "x": 240, "y": 86, "radius": 38, "thickness": 8,
      "color": "#00E08A", "background": "#232A38", "text": { "format": "{0:F0}%", "size": 22, "weight": 600 } },
    { "type": "text", "sensors": ["cpu.freq", "cpu.temp"], "format": "{0:F1} GHz  {1:F0}°C", "x": 240, "y": 132, "align": "center",
      "size": 15, "weight": 600, "color": "#C8CEDA" },

    // ── RAM gauge ───────────────────────────────────────────────────────────
    { "type": "panel", "x": 324, "y": 8, "w": 148, "h": 148, "radius": 10, "fill": "#B0080C14", "border": { "color": "#1E2636", "width": 1 },
      "accent": { "edge": "top", "color": "#A56BFF", "width": 3 } },
    { "type": "text", "value": "", "font": "Segoe Fluent Icons", "size": 15, "x": 336, "y": 21, "color": "#A56BFF" },
    { "type": "text", "value": "RAM", "x": 358, "y": 22, "size": 13, "weight": 600, "color": "#8A93A6" },
    { "type": "gauge", "sensor": "mem.load", "x": 398, "y": 86, "radius": 38, "thickness": 8,
      "color": "#A56BFF", "background": "#232A38", "text": { "format": "{0:F0}%", "size": 22, "weight": 600 } },
    { "type": "text", "sensors": ["mem.used", "mem.total"], "format": "{0:F1} / {1:F0} GB", "x": 398, "y": 132, "align": "center",
      "size": 15, "weight": 600, "color": "#C8CEDA" },

    // ── Network: download above the line, upload hanging below it ───────────
    { "type": "panel", "x": 8, "y": 164, "w": 148, "h": 148, "radius": 10, "fill": "#B0080C14", "border": { "color": "#1E2636", "width": 1 },
      "accent": { "edge": "top", "color": "#00C8FF", "width": 3 } },
    { "type": "text", "value": "", "font": "Segoe Fluent Icons", "size": 15, "x": 20, "y": 177, "color": "#00C8FF" },
    { "type": "text", "value": "NET", "x": 42, "y": 178, "size": 13, "weight": 600, "color": "#8A93A6" },
    { "type": "text", "value": "MB/s", "x": 144, "y": 178, "align": "right", "size": 13, "weight": 600, "color": "#8A93A6" },
    { "type": "text", "value": "", "font": "Segoe Fluent Icons", "size": 16, "x": 20, "y": 205, "color": "#00C8FF" },
    { "type": "text", "sensor": "net.down", "format": "{0:F1}", "x": 144, "y": 202, "align": "right", "size": 24, "weight": 600, "color": "#00C8FF" },
    { "type": "text", "value": "", "font": "Segoe Fluent Icons", "size": 16, "x": 20, "y": 233, "color": "#FF5C8A" },
    { "type": "text", "sensor": "net.up", "format": "{0:F1}", "x": 144, "y": 230, "align": "right", "size": 24, "weight": 600, "color": "#FF5C8A" },
    { "type": "graph", "sensor": "net.down", "x": 20, "y": 262, "w": 124, "h": 19, "history": 45, "max": 30, "color": "#00C8FF", "fill": true },
    { "type": "panel", "x": 20, "y": 281, "w": 124, "h": 1, "fill": "#2A3242" },
    { "type": "graph", "sensor": "net.up", "x": 20, "y": 282, "w": 124, "h": 19, "history": 45, "max": 30, "flip": true,
      "color": "#FF5C8A", "fill": true },

    // ── Disk activity on C: read above the line, write hanging below it ─────
    { "type": "panel", "x": 166, "y": 164, "w": 148, "h": 148, "radius": 10, "fill": "#B0080C14", "border": { "color": "#1E2636", "width": 1 },
      "accent": { "edge": "top", "color": "#3D8BFF", "width": 3 } },
    { "type": "text", "value": "", "font": "Segoe Fluent Icons", "size": 15, "x": 178, "y": 177, "color": "#3D8BFF" },
    { "type": "text", "value": "DISK", "x": 200, "y": 178, "size": 13, "weight": 600, "color": "#8A93A6" },
    { "type": "text", "value": "MB/s", "x": 302, "y": 178, "align": "right", "size": 13, "weight": 600, "color": "#8A93A6" },
    { "type": "text", "value": "R", "x": 179, "y": 205, "size": 16, "weight": 700, "color": "#3D8BFF" },
    { "type": "text", "sensor": "disk.read", "format": "{0:F0}", "x": 302, "y": 202, "align": "right", "size": 24, "weight": 600, "color": "#3D8BFF" },
    { "type": "text", "value": "W", "x": 178, "y": 233, "size": 16, "weight": 700, "color": "#FF5C8A" },
    { "type": "text", "sensor": "disk.write", "format": "{0:F0}", "x": 302, "y": 230, "align": "right", "size": 24, "weight": 600, "color": "#FF5C8A" },
    { "type": "graph", "sensor": "disk.read", "x": 178, "y": 262, "w": 124, "h": 19, "history": 45, "max": 200, "color": "#3D8BFF", "fill": true },
    { "type": "panel", "x": 178, "y": 281, "w": 124, "h": 1, "fill": "#2A3242" },
    { "type": "graph", "sensor": "disk.write", "x": 178, "y": 282, "w": 124, "h": 19, "history": 45, "max": 200, "flip": true,
      "color": "#FF5C8A", "fill": true },

    // ── Power: the whole PC at the wall, worked out from the CPU and GPU ("wallPower" in settings.json)
    { "type": "panel", "x": 324, "y": 164, "w": 148, "h": 148, "radius": 10, "fill": "#B0080C14", "border": { "color": "#1E2636", "width": 1 },
      "accent": { "edge": "top", "color": "#FFC53D", "width": 3 } },
    { "type": "text", "value": "", "font": "Segoe Fluent Icons", "size": 15, "x": 336, "y": 177, "color": "#FFC53D" },
    { "type": "text", "value": "POWER", "x": 358, "y": 178, "size": 13, "weight": 600, "color": "#8A93A6" },
    { "type": "text", "value": "W", "x": 460, "y": 178, "align": "right", "size": 13, "weight": 600, "color": "#8A93A6" },
    { "type": "text", "sensor": "power.wall", "format": "{0:F0}", "x": 398, "y": 206, "align": "center", "size": 40, "weight": 600, "color": "#FFC53D" },
    { "type": "graph", "sensor": "power.wall", "x": 336, "y": 258, "w": 124, "h": 43, "history": 45, "max": 500, "color": "#FFC53D", "fill": true }
  ]
}
