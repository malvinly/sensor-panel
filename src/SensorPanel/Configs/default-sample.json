{
  // Turing Smart Screen dashboard. See docs/guide.md for the full schema.
  // Widgets are drawn in order, later ones on top. After editing, pick the config again
  // from the tray menu.
  "name": "Default sample",
  "refreshMs": 1000,
  "orientation": "landscape",
  "brightness": 20,
  "background": "#000000",
  "widgets": [
    { "type": "image", "path": "media/background.png", "x": 0, "y": 0 },

    // ── Clock ───────────────────────────────────────────────────────────────
    { "type": "panel", "x": 8, "y": 8, "w": 224, "h": 112, "radius": 10,
      "fill": "#B0080C14", "border": { "color": "#1E2636", "width": 1 } },
    { "type": "text", "clock": "HH:mm", "x": 120, "y": 26, "align": "center",
      "font": "Segoe UI", "size": 74, "weight": 600, "color": "#FFFFFF" },
    { "type": "text", "clock": "ddd  dd  MMM  yyyy", "upper": true, "x": 120, "y": 93, "align": "center",
      "font": "Segoe UI", "size": 15, "weight": 600, "color": "#00C8FF" },

    // ── GPU: two arc gauges ─────────────────────────────────────────────────
    { "type": "panel", "x": 8, "y": 128, "w": 224, "h": 112, "radius": 10,
      "fill": "#B0080C14", "border": { "color": "#1E2636", "width": 1 },
      "accent": { "edge": "top", "color": "#FF7A3D", "width": 3 } },
    { "type": "text", "value": "", "font": "Segoe Fluent Icons", "size": 15, "x": 20, "y": 141, "color": "#FF7A3D" },
    { "type": "text", "value": "GPU", "x": 42, "y": 142, "size": 13, "weight": 600, "color": "#8A93A6" },
    { "type": "text", "sensor": "gpu.power", "format": "{0:F0} W", "x": 220, "y": 142, "align": "right",
      "font": "Consolas", "size": 13, "color": "#C8CEDA" },

    { "type": "gauge", "sensor": "gpu.load", "x": 66, "y": 198, "radius": 34, "thickness": 7,
      "startAngle": 135, "endAngle": 45, "min": 0, "max": 100,
      "color": "#FF7A3D", "background": "#232A38",
      "text": { "format": "{0:F0}%", "size": 19, "weight": 600 } },
    { "type": "text", "value": "LOAD", "x": 66, "y": 228, "align": "center", "size": 9, "weight": 600, "color": "#8A93A6" },

    { "type": "gauge", "sensor": "gpu.temp", "x": 174, "y": 198, "radius": 34, "thickness": 7,
      "startAngle": 135, "endAngle": 45, "min": 20, "max": 90,
      "color": "#FFC53D", "background": "#232A38",
      "text": { "format": "{0:F0}°", "size": 19, "weight": 600 } },
    { "type": "text", "value": "TEMP", "x": 174, "y": 228, "align": "center", "size": 9, "weight": 600, "color": "#8A93A6" },

    // ── CPU: sparkline ──────────────────────────────────────────────────────
    { "type": "panel", "x": 240, "y": 8, "w": 232, "h": 72, "radius": 10,
      "fill": "#B0080C14", "accent": { "edge": "left", "color": "#00E08A", "width": 4 } },
    { "type": "text", "value": "", "font": "Segoe Fluent Icons", "size": 24, "x": 254, "y": 18, "color": "#00E08A" },
    { "type": "text", "value": "CPU", "x": 288, "y": 18, "size": 13, "weight": 600, "color": "#8A93A6" },
    { "type": "text", "sensors": ["cpu.freq", "cpu.temp"], "format": "{0:F1} GHz  {1:F0}°C", "x": 288, "y": 35,
      "font": "Consolas", "size": 11, "color": "#C8CEDA" },
    { "type": "text", "sensor": "cpu.load", "format": "{0:F0}%", "x": 462, "y": 18, "align": "right",
      "size": 30, "weight": 600, "color": "#00E08A" },
    { "type": "graph", "sensor": "cpu.load", "x": 254, "y": 51, "w": 208, "h": 22, "history": 60,
      "min": 0, "max": 100, "color": "#00E08A", "fill": true },

    // ── RAM: segmented meter ────────────────────────────────────────────────
    { "type": "panel", "x": 240, "y": 88, "w": 232, "h": 72, "radius": 10,
      "fill": "#B0080C14", "accent": { "edge": "left", "color": "#A56BFF", "width": 4 } },
    { "type": "text", "value": "", "font": "Segoe Fluent Icons", "size": 24, "x": 254, "y": 98, "color": "#A56BFF" },
    { "type": "text", "value": "RAM", "x": 288, "y": 98, "size": 13, "weight": 600, "color": "#8A93A6" },
    { "type": "text", "sensors": ["mem.used", "mem.total"], "format": "{0:F1} / {1:F0} GB", "x": 288, "y": 115,
      "font": "Consolas", "size": 11, "color": "#C8CEDA" },
    { "type": "text", "sensor": "mem.load", "format": "{0:F0}%", "x": 462, "y": 98, "align": "right",
      "size": 30, "weight": 600, "color": "#A56BFF" },
    { "type": "bar", "sensor": "mem.load", "x": 254, "y": 134, "w": 208, "h": 16, "min": 0, "max": 100,
      "segments": 20, "gap": 3, "radius": 2, "color": "#A56BFF", "background": "#232A38" },

    // ── SSD: continuous bar ─────────────────────────────────────────────────
    { "type": "panel", "x": 240, "y": 168, "w": 232, "h": 72, "radius": 10,
      "fill": "#B0080C14", "accent": { "edge": "left", "color": "#3D8BFF", "width": 4 } },
    { "type": "text", "value": "", "font": "Segoe Fluent Icons", "size": 24, "x": 254, "y": 178, "color": "#3D8BFF" },
    { "type": "text", "value": "SSD", "x": 288, "y": 178, "size": 13, "weight": 600, "color": "#8A93A6" },
    { "type": "text", "sensors": ["disk.used", "disk.total"], "format": "{0:F0} / {1:F0} GB", "x": 288, "y": 195,
      "font": "Consolas", "size": 11, "color": "#C8CEDA" },
    { "type": "text", "sensor": "disk.load", "format": "{0:F0}%", "x": 462, "y": 178, "align": "right",
      "size": 30, "weight": 600, "color": "#3D8BFF" },
    { "type": "bar", "sensor": "disk.load", "x": 254, "y": 218, "w": 208, "h": 10, "min": 0, "max": 100,
      "radius": 5, "color": "#3D8BFF", "background": "#232A38" },

    // ── Bottom row ──────────────────────────────────────────────────────────
    { "type": "panel", "x": 8, "y": 248, "w": 110, "h": 64, "radius": 10, "fill": "#B0080C14",
      "accent": { "edge": "bottom", "color": "#00C8FF", "width": 2 } },
    { "type": "text", "value": "", "font": "Segoe Fluent Icons", "size": 13, "x": 18, "y": 258, "color": "#00C8FF" },
    { "type": "text", "value": "DOWN", "x": 36, "y": 259, "size": 10, "weight": 600, "color": "#8A93A6" },
    { "type": "text", "sensor": "net.down", "format": "{0:F1}", "x": 18, "y": 277, "size": 19, "weight": 600 },
    { "type": "text", "value": "MB/s", "x": 108, "y": 284, "align": "right", "size": 9, "color": "#8A93A6" },
    { "type": "graph", "sensor": "net.down", "x": 18, "y": 296, "w": 90, "h": 10, "history": 45,
      "min": 0, "max": 30, "color": "#00C8FF", "thickness": 1 },

    { "type": "panel", "x": 126, "y": 248, "w": 110, "h": 64, "radius": 10, "fill": "#B0080C14",
      "accent": { "edge": "bottom", "color": "#FF5C8A", "width": 2 } },
    { "type": "text", "value": "", "font": "Segoe Fluent Icons", "size": 13, "x": 136, "y": 258, "color": "#FF5C8A" },
    { "type": "text", "value": "UP", "x": 154, "y": 259, "size": 10, "weight": 600, "color": "#8A93A6" },
    { "type": "text", "sensor": "net.up", "format": "{0:F1}", "x": 136, "y": 277, "size": 19, "weight": 600 },
    { "type": "text", "value": "MB/s", "x": 226, "y": 284, "align": "right", "size": 9, "color": "#8A93A6" },
    { "type": "graph", "sensor": "net.up", "x": 136, "y": 296, "w": 90, "h": 10, "history": 45,
      "min": 0, "max": 30, "color": "#FF5C8A", "thickness": 1 },

    { "type": "panel", "x": 244, "y": 248, "w": 110, "h": 64, "radius": 10, "fill": "#B0080C14",
      "accent": { "edge": "bottom", "color": "#FFC53D", "width": 2 } },
    { "type": "text", "value": "", "font": "Segoe Fluent Icons", "size": 13, "x": 254, "y": 258, "color": "#FFC53D" },
    { "type": "text", "value": "VRAM", "x": 272, "y": 259, "size": 10, "weight": 600, "color": "#8A93A6" },
    { "type": "text", "sensor": "gpu.mem.used", "format": "{0:F1}", "x": 254, "y": 277, "size": 19, "weight": 600 },
    { "type": "text", "value": "GB", "x": 344, "y": 284, "align": "right", "size": 9, "color": "#8A93A6" },
    { "type": "bar", "sensor": "gpu.mem.used", "x": 254, "y": 298, "w": 90, "h": 6, "min": 0, "max": 16,
      "segments": 12, "gap": 2, "color": "#FFC53D", "background": "#232A38" },

    { "type": "panel", "x": 362, "y": 248, "w": 110, "h": 64, "radius": 10, "fill": "#B0080C14",
      "accent": { "edge": "bottom", "color": "#8A93A6", "width": 2 } },
    { "type": "text", "value": "", "font": "Segoe Fluent Icons", "size": 13, "x": 372, "y": 258, "color": "#C8CEDA" },
    { "type": "text", "value": "UPTIME", "x": 390, "y": 259, "size": 10, "weight": 600, "color": "#8A93A6" },
    { "type": "text", "sensors": ["uptime.days", "uptime.hours", "uptime.minutes"], "format": "{0:0}d {1:0}h {2:00}m",
      "x": 372, "y": 281, "font": "Consolas", "size": 15, "color": "#FFFFFF" }
  ]
}
