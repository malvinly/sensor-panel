{
  // CPU and GPU as two rows: a big load number and temperature at the left, two minutes of
  // load history at the right. RAM along the bottom.
  "name": "Simple rows",
  "refreshMs": 1000,
  "orientation": "landscape",
  "brightness": 20,
  "background": "#05070A",
  "widgets": [
    // ── CPU ─────────────────────────────────────────────────────────────────
    { "type": "panel", "x": 8, "y": 8, "w": 464, "h": 118, "radius": 10,
      "fill": "#0E1218", "accent": { "edge": "left", "color": "#00E08A", "width": 4 } },
    { "type": "text", "value": "CPU", "x": 26, "y": 25, "size": 15, "weight": 600, "color": "#8A93A6" },
    { "type": "text", "sensor": "cpu.temp", "format": "{0:F0}°C", "x": 180, "y": 21, "align": "right",
      "size": 24, "weight": 600, "color": "#FFFFFF" },
    { "type": "text", "sensor": "cpu.load", "format": "{0:F0}%", "x": 24, "y": 62,
      "size": 64, "weight": 600, "color": "#00E08A" },
    { "type": "graph", "sensor": "cpu.load", "x": 196, "y": 22, "w": 264, "h": 92, "history": 120,
      "min": 0, "max": 100, "color": "#00E08A", "thickness": 2.5, "fill": true },

    // ── GPU ─────────────────────────────────────────────────────────────────
    { "type": "panel", "x": 8, "y": 134, "w": 464, "h": 118, "radius": 10,
      "fill": "#0E1218", "accent": { "edge": "left", "color": "#FF7A3D", "width": 4 } },
    { "type": "text", "value": "GPU", "x": 26, "y": 151, "size": 15, "weight": 600, "color": "#8A93A6" },
    { "type": "text", "sensor": "gpu.temp", "format": "{0:F0}°C", "x": 180, "y": 147, "align": "right",
      "size": 24, "weight": 600, "color": "#FFFFFF" },
    { "type": "text", "sensor": "gpu.load", "format": "{0:F0}%", "x": 24, "y": 188,
      "size": 64, "weight": 600, "color": "#FF7A3D" },
    { "type": "graph", "sensor": "gpu.load", "x": 196, "y": 148, "w": 264, "h": 92, "history": 120,
      "min": 0, "max": 100, "color": "#FF7A3D", "thickness": 2.5, "fill": true },

    // ── RAM ─────────────────────────────────────────────────────────────────
    { "type": "panel", "x": 8, "y": 260, "w": 464, "h": 52, "radius": 10, "fill": "#0E1218" },
    { "type": "text", "value": "RAM", "x": 26, "y": 281, "size": 15, "weight": 600, "color": "#8A93A6" },
    { "type": "bar", "sensor": "mem.load", "x": 74, "y": 276, "w": 316, "h": 20, "min": 0, "max": 100,
      "segments": 24, "gap": 3, "radius": 2, "color": "#A56BFF", "background": "#1A1F27" },
    { "type": "text", "sensor": "mem.load", "format": "{0:F0}%", "x": 460, "y": 276, "align": "right",
      "size": 28, "weight": 600, "color": "#A56BFF" }
  ]
}
