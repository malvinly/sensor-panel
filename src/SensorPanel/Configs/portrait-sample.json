{
  // A second layout to show that the look is all config: portrait, no background image,
  // monospace type, flat panels. Pick "Portrait sample" from the tray menu.
  "name": "Portrait sample",
  "refreshMs": 2000,
  "orientation": "portrait",
  "brightness": 30,
  "background": "#06080B",
  "widgets": [
    { "type": "text", "clock": "HH:mm", "x": 160, "y": 24, "align": "center",
      "font": "Consolas", "size": 96, "weight": 700, "color": "#E8FF5A" },
    { "type": "text", "clock": "dddd d MMMM", "upper": true, "x": 160, "y": 104, "align": "center",
      "font": "Consolas", "size": 16, "color": "#7C8694" },

    { "type": "gauge", "sensor": "cpu.load", "x": 88, "y": 212, "radius": 62, "thickness": 12,
      "startAngle": 90, "endAngle": 90, "color": "#E8FF5A", "background": "#1A1F27",
      "text": { "format": "{0:F0}", "font": "Consolas", "size": 40, "weight": 700 } },
    { "type": "text", "value": "CPU %", "x": 88, "y": 284, "align": "center", "font": "Consolas", "size": 13, "color": "#7C8694" },

    { "type": "gauge", "sensor": "gpu.load", "x": 232, "y": 212, "radius": 62, "thickness": 12,
      "startAngle": 90, "endAngle": 90, "clockwise": false, "color": "#5AC8FF", "background": "#1A1F27",
      "text": { "format": "{0:F0}", "font": "Consolas", "size": 40, "weight": 700 } },
    { "type": "text", "value": "GPU %", "x": 232, "y": 284, "align": "center", "font": "Consolas", "size": 13, "color": "#7C8694" },

    { "type": "panel", "x": 12, "y": 316, "w": 296, "h": 70, "fill": "#0E1218",
      "border": { "color": "#252C37", "width": 1 }, "accent": { "edge": "top", "color": "#E8FF5A", "width": 2 } },
    { "type": "text", "value": "MEMORY", "x": 24, "y": 330, "font": "Consolas", "size": 13, "color": "#7C8694" },
    { "type": "text", "sensors": ["mem.used", "mem.total"], "format": "{0:F1} / {1:F0} GB", "x": 296, "y": 330, "align": "right",
      "font": "Consolas", "size": 13, "color": "#FFFFFF" },
    { "type": "bar", "sensor": "mem.load", "x": 24, "y": 354, "w": 272, "h": 20, "segments": 34, "gap": 2,
      "color": "#E8FF5A", "background": "#1A1F27" },

    { "type": "panel", "x": 12, "y": 398, "w": 296, "h": 70, "fill": "#0E1218",
      "border": { "color": "#252C37", "width": 1 }, "accent": { "edge": "top", "color": "#5AC8FF", "width": 2 } },
    { "type": "text", "value": "GPU TEMP", "x": 24, "y": 412, "font": "Consolas", "size": 13, "color": "#7C8694" },
    { "type": "text", "sensor": "gpu.temp", "format": "{0:F0} °C", "x": 296, "y": 412, "align": "right",
      "font": "Consolas", "size": 13, "color": "#FFFFFF" },
    { "type": "graph", "sensor": "gpu.temp", "x": 24, "y": 432, "w": 272, "h": 28, "history": 90,
      "min": 20, "max": 90, "color": "#5AC8FF", "fill": true }
  ]
}
