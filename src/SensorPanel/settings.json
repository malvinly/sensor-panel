// Choices about this PC rather than about a layout. Read once at start, so restart SensorPanel
// after editing. Every setting is described in docs/guide.md, under settings.json.
{
  // true: read the GPU through LibreHardwareMonitor instead of NVIDIA's NVML.
  "lhmGpu": false,

  // true: the panel is mounted the other way up, so turn every layout 180°.
  "upsideDown": false,

  // Panel brightness, 0-100. A layout with its own "brightness" uses that instead.
  "brightness": 30,

  // Where the weather on the default layout is for, in decimal degrees (south and west are
  // negative). Until both are set, the weather shows "--". While a layout shows the weather,
  // they are sent to Open-Meteo (open-meteo.com), rounded to two decimals, about every 15 minutes.
  "weather": {
    "latitude": null,
    "longitude": null,
    // true: temperatures in °F instead of °C.
    "fahrenheit": false
  },

  // Show another layout while a game runs, and go back to yours after it ends.
  // Off while "games" is empty, or holds only "!" entries.
  "gaming": {
    // Relative to the configs folder. The exe writes the gaming layout there on first start.
    "config": "gaming/gaming.json",
    // Exes that are games: a path ("*/steamapps/common/*") or a file name ("eldenring.exe"),
    // with * and ? as wildcards, ignoring case. A "!" first marks exes that are never games:
    // "!*/steamapps/common/wallpaper_engine/*".
    "games": [],
    // How often to look for a running game, in ms (500 to 60000).
    "scanMs": 2000,
    // How long the gaming layout stays after the last game exits, in ms (0 to 3600000).
    "endAfterMs": 30000
  }
}
